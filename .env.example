# Copy to .env.local and fill in. Never commit .env.local.
# Local values come from `npm run db:start` (it prints the URL and keys).

# Supabase project URL (local default shown)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable key (sb_publishable_...). Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). SERVER ONLY: bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Base URL of this deployment, used for auth email redirects and share links.
# Optional on Netlify: defaults to the project's main address.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. PDF upload limit in MB (default 20). Keep in sync with storage.file_size_limit
# in supabase/config.toml.
NEXT_PUBLIC_MAX_UPLOAD_MB=20

# Optional, local only. Used by `npm run db:types:remote` (Project Settings → General → Project ID).
# Not needed on Netlify.
SUPABASE_PROJECT_ID=
